{
  "info": {
    "_postman_id": "deskelp-it-helpdesk-api",
    "name": "Deskelp IT Helpdesk REST API",
    "description": "Comprehensive Postman API collection for the Deskelp IT Helpdesk platform (Java Servlets, JDBC, MySQL, JWT, BCrypt).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/helpdesk-ticket-system/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('JWT Token saved successfully.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Agent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('JWT Token saved successfully.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@helpdesk.com\",\n  \"password\": \"agent123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Employee\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Employee Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN connection drops unexpectedly during video calls\",\n  \"description\": \"Every time I join a high-bandwidth meeting, the internal staging gateway drops.\",\n  \"category\": \"NETWORK\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/create",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "create"]
            }
          }
        },
        {
          "name": "Get My Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/my",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "my"]
            }
          }
        },
        {
          "name": "Get Ticket Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/details?id={{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "details"],
              "query": [
                {
                  "key": "id",
                  "value": "{{ticketId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Post Ticket Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": {{ticketId}},\n  \"message\": \"Reinstalled the client as suggested, testing now.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/comment",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "comment"]
            }
          }
        },
        {
          "name": "Close Ticket (Employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": {{ticketId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/close",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "close"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Administrator Operations",
      "item": [
        {
          "name": "Get All Tickets & Agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tickets"]
            }
          }
        },
        {
          "name": "Assign Ticket to Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": {{ticketId}},\n  \"agentId\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/assign",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "assign"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Support Agent Operations",
      "item": [
        {
          "name": "Get Agent Assigned Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agent/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "tickets"]
            }
          }
        },
        {
          "name": "Update Status (IN_PROGRESS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": {{ticketId}},\n  \"newStatus\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/update-status",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "update-status"]
            }
          }
        },
        {
          "name": "Update Status (RESOLVED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": {{ticketId}},\n  \"newStatus\": \"RESOLVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/update-status",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "update-status"]
            }
          }
        }
      ]
    }
  ]
}

